# Copy to .env for local development. Values below match docker-compose.yml.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres (pgvector image from docker-compose)
#
# Two connections on purpose. DATABASE_URL is what the API and worker run as:
# a least-privilege role that owns nothing and is subject to Row Level
# Security. MIGRATION_DATABASE_URL is the owner, used only by drizzle-kit and
# `pnpm db:bootstrap`. Application processes must never receive it — a role
# that owns a table can also disable that table's RLS policies.
DATABASE_URL=postgres://alexandria_app:alexandria_app@localhost:5432/alexandria
MIGRATION_DATABASE_URL=postgres://alexandria:alexandria@localhost:5432/alexandria

# Consumed only by `pnpm db:bootstrap`, which creates the role above.
# In production the role is provisioned by IaC and these are not set.
APP_DATABASE_ROLE=alexandria_app
APP_DATABASE_PASSWORD=alexandria_app

# Redis (BullMQ, caching, rate limits)
REDIS_URL=redis://localhost:6379

# Object storage — MinIO locally, S3 in production (same SDK)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=alexandria
S3_SECRET_KEY=alexandria-secret
S3_BUCKET=alexandria-documents
S3_FORCE_PATH_STYLE=true
UPLOAD_URL_TTL_SECONDS=900
MAX_DOCUMENT_BYTES=26214400

# Ingestion
# The queue NAME is a constant, not a setting: renaming it orphans every job
# already enqueued under the old name.
INGESTION_WORKER_CONCURRENCY=2   # jobs processed in parallel per worker process
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# HNSW visit budget per query (pgvector caps it at 1000). The default 40 is
# tuned for global search; per-tenant filtered search needs headroom for the
# iterative scan to reach past the global top-k cut, where another tenant's
# near-identical chunks crowd the ranking. 80 = measured recall headroom at
# small latency cost; doc 12 charts the curve.
HNSW_EF_SEARCH=80
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Authentication. Use a different random value in every environment.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# LLM providers
# Generation rides the Ollama cloud subscription (chat-only endpoint);
# embeddings stay on local Ollama — the cloud host has no /api/embeddings.
OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=          # ollama.com cloud key; leave unset for local Ollama
LLM_CHAIN=ollama           # comma-separated fallback chain ('ollama,gemini'); 'scripted' = deterministic, no model needed
GENERATION_MODEL=gpt-oss:120b
GENERATION_NUM_CTX=8192    # sent explicitly — Ollama's 2048 default truncates the prompt front
GENERATION_MAX_TOKENS=1024
GENERATION_TEMPERATURE=0.2   # grounded answering is not a creative task; Ollama defaults to 0.8
CHAT_HISTORY_MESSAGES=10
CHAT_HISTORY_TOKEN_BUDGET=1500   # a message count is not a size bound
CHAT_CONTEXT_TOKEN_BUDGET=3000   # a ceiling; the window's remainder can be smaller
# The pre-frame window: everything that must finish while the status line is
# still ours (conversation, idempotency, history, rewrite, retrieval). 20s is
# comfortably under nginx's 60s default idle timeout — the deadline decides
# the error the client sees, not the proxy. Disarmed after the first frame.
CHAT_PRE_FRAME_DEADLINE_MS=20000
# The query rewrite is an optimization that fails open; a cold model must not
# eat the whole window. ~25% of it; expiry aborts with a reason and the
# ledger records 'timeout', never 'client_disconnect'.
CHAT_REWRITE_BUDGET_MS=5000
# SSE heartbeat comment interval, armed only after the first frame (arming it
# earlier let a timer race the lazy 200-commit and convert real HTTP errors
# into SSE error frames). 15s keeps idle proxies from killing the socket.
CHAT_HEARTBEAT_MS=15000

# Gemini — the second chain member (demo mode). Free-tier friendly,
# non-reasoning: same token-frugality call as gpt-oss:120b.
# Naming gemini in LLM_CHAIN without this key is refused at BOOT: a fallback
# is only exercised once the primary is down, so a missing key would surface
# mid-incident.
# GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.1-flash-lite   # cheapest flash tier AND zero thinking tokens (measured); see pricing.ts
GEMINI_NUM_CTX=1048576     # the model's real input limit; chains report the MIN window

# Resilience (Phase 6). Two deadlines, not one: a cold model load is slow to
# FIRST token; silence mid-stream is a stall.
LLM_MAX_RETRIES=2          # per chain step, not shared across the chain
LLM_RETRY_BASE_MS=500      # full jitter decorrelates thundering herds
LLM_RETRY_AFTER_CAP_MS=10000  # "wait 60s" is a fallback signal, not a retry invitation
LLM_FIRST_TOKEN_TIMEOUT_MS=30000
LLM_IDLE_TIMEOUT_MS=30000
EMBEDDING_TIMEOUT_MS=30000 # single request/response: one plain timeout
EMBEDDING_MAX_RETRIES=2
# Exact-match embedding cache TTL (Phase 7). Key is sha256(model + text):
# changing the model empties the cache by construction. 24h makes re-ingest
# of unchanged documents free; cache failures never fail the embed call.
EMBEDDING_CACHE_TTL_SECONDS=86400
