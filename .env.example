# Copy to .env for local development. Values below match docker-compose.yml.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres (pgvector image from docker-compose)
DATABASE_URL=postgres://alexandria:alexandria@localhost:5432/alexandria

# Redis (BullMQ, caching, rate limits)
REDIS_URL=redis://localhost:6379

# Object storage — MinIO locally, S3 in production (same SDK)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=alexandria
S3_SECRET_KEY=alexandria-secret
S3_BUCKET=alexandria-documents
S3_FORCE_PATH_STYLE=true
UPLOAD_URL_TTL_SECONDS=900
MAX_DOCUMENT_BYTES=26214400

# Ingestion
INGESTION_QUEUE=document-ingestion
INGESTION_WORKER_CONCURRENCY=2
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Authentication. Use a different random value in every environment.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# LLM providers
OLLAMA_BASE_URL=http://localhost:11434
# GEMINI_API_KEY=            # only needed for demo mode (Phase 6)
